rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isStaff() {
      return isSignedIn() && (getUserData().role == 'staff' || getUserData().role == 'admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Collection: Users
    match /users/{userId} {
      allow read: if isStaff() || isOwner(userId);
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.email == 'balajidamineni@gmail.com');
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'firstLogin', 'phone', 'qrCodeData']));
      allow delete: if isAdmin();
    }

    // Public connection test document
    match /test/connection {
      allow read: if true;
    }

    // Collection: Meals
    match /meals/{mealId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // Collection: Registrations
    match /registrations/{regId} {
      function isValidRegistration(data) {
        return data.userId is string && data.mealId is string && data.status in ['REGISTERED', 'VERIFIED', 'ABSENT'];
      }

      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidRegistration(request.resource.data) && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isStaff();
    }

    // Collection: Stats
    match /stats/{statId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
