rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffOrAdmin() {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']) ||
             (request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['admin', 'staff']);
    }

    function isOwner(userId) {
      return request.auth.uid == userId || (request.auth.token.email != null && request.auth.token.email == userId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (isOwner(userId) || isStaffOrAdmin());
    }

    match /test/connection {
      allow read, write: if true;
    }

    match /meals/{mealId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isStaffOrAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isStaffOrAdmin());
      allow create: if isSignedIn() && (isOwner(request.resource.data.userId) || isStaffOrAdmin());
      allow update, delete: if isSignedIn() && (isOwner(resource.data.userId) || isStaffOrAdmin());
    }

    match /stats/{statId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isStaffOrAdmin();
    }
  }
}
